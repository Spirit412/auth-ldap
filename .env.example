# APS runtime configuration template. Copy to .env and fill in.
# SECURITY: secrets belong in .env (gitignored) or a secret manager.

# --- HTTP ---
LISTEN_ADDR=:8080            # set via compose; change if running bare
DOCS_ENABLED=true            # false in production disables /docs + /openapi.json
COOKIE_SECURE=true           # false ONLY for plain-http localhost testing
COOKIE_DOMAIN=               # empty = host-only cookie

# --- LDAP (S-02/S-03) ---
# ldaps:// is mandatory; ldap:// is accepted only with LDAP_STARTTLS=true.
LDAP_URL=ldaps://ad.corp.local:636
LDAP_STARTTLS=false
LDAP_CA_CERT_FILE=           # PEM bundle of the internal PKI CA (recommended)
LDAP_TLS_INSECURE=false      # true ONLY against a mock LDAP in dev!
LDAP_BIND_DN=CN=svc-aps,OU=Service Accounts,DC=corp,DC=local
LDAP_BIND_PASSWORD=change-me  # or LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind
LDAP_BASE_DN=DC=corp,DC=local
LDAP_USER_ATTR=sAMAccountName
LDAP_NAME_ATTR=displayName
LDAP_MAIL_ATTR=mail
# Members of this group receive the "admin" role claim (S-12).
LDAP_ADMIN_GROUP_DN=CN=APS-Admins,OU=Groups,DC=corp,DC=local
LDAP_POOL_SIZE=5
LDAP_TIMEOUT=10s
LDAP_RETRY=3

# --- Redis (existing shared instance) ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=aps:        # shared Redis: keep APS keys namespaced

# --- PostgreSQL (existing instance, dedicated db+user) ---
PG_HOST=postgres
PG_PORT=5432
PG_USER=aps
PG_PASSWORD=change-me
PG_DATABASE=aps
PG_SSLMODE=prefer
PG_POOL_MAX=10
DB_MIGRATE=true              # auto-apply embedded migrations at startup

# --- JWT keys (S-11: private key is a FILE path, never an env value) ---
JWT_PRIVATE_KEY_FILE=/keys/jwt-active.pem
JWT_KEY_ID=2026-01
JWT_PREV_KEYS_DIR=           # dir with previous PUBLIC keys <kid>.pem (rotation)
JWT_ISSUER=aps
JWT_AUDIENCE=aps-clients
ACCESS_TOKEN_TTL=15m         # max 15m per ТЗ S-05
REFRESH_TOKEN_TTL=168h       # 7..30 days

# --- Rate limiting (S-06, Redis GCRA) ---
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=15m
REFRESH_RATE_LIMIT=10
REFRESH_RATE_WINDOW=1m

# --- Trusted proxies (S-06): X-Forwarded-For honoured only from these CIDRs ---
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json              # console for local debugging
